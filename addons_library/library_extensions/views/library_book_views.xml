<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="book_tree_add_fields" model="ir.ui.view">
        <field name="name">library.book.tree.extensions</field>
        <field name="model">library.book</field>
        <field name="inherit_id" ref="library.library_book_view_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="author_id"/>
                <field name="category_id" widget="many2many_tags"/>
            </field>
        </field>
    </record>

    <record id="book_form_add_fields" model="ir.ui.view">
        <field name="name">library.book.form.extensions</field>
        <field name="model">library.book</field>
        <field name="inherit_id" ref="library.library_book_view_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="author_id"/>
                <field name="category_id" widget="many2many_tags"/>
            </field>
        </field>
    </record>
</odoo>